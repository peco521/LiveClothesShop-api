# Plantilla ficticia de LiveClothesShop API. Copiar a .env (ignorado por Git).
#
# El MISMO código sirve para dos escenarios; lo único que cambia es la
# configuración externa:
#   - ESCENARIO A (abajo, valores activos): desarrollo local con Postgres local,
#     frontend http://localhost:4200 y Stripe en MODO PRUEBA.
#   - ESCENARIO B (comentado al final): producción con variables del entorno
#     (Render), frontend HTTPS y Stripe en MODO VIVO.
#
# El .env del desarrollador nunca se sube al repositorio ni se copia al servidor.
# Las variables del entorno del proceso tienen prioridad sobre este archivo, así
# que Render sobrescribe cualquier valor sin editar código fuente.

# =============================================================================
# ESCENARIO A — DESARROLLO LOCAL
# =============================================================================
ENVIRONMENT=development
# Argon2id por defecto. plaintext muestra contraseñas en la BD: solo para
# demostraciones académicas con cuentas ficticias; prohibido en producción.
PASSWORD_STORAGE=argon2id

# Reemplazar TODOS los placeholders. Codificar caracteres especiales del password
# como componentes URL: @ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25.
DATABASE_URL=postgresql+psycopg://USUARIO_PLACEHOLDER:PASSWORD_URL_ENCODED_PLACEHOLDER@HOST_PLACEHOLDER:5432/DATABASE_PLACEHOLDER

# ID real del rol publico Cliente (maximo 15 caracteres); no crea el rol.
CLIENTE_ROL_ID=ROL_PLACEHOLDER
# Accesos en memoria: ejecutar una sola instancia/worker de la API.
# Reiniciar el proceso exige iniciar sesion de nuevo; no requiere tabla sesion.
SESSION_HOURS=8
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=["http://localhost:4200","http://localhost:4300"]
# Gmail API (opcional). Credenciales solo en .env; nunca en Angular.
RECOVERY_DELIVERY=disabled
RECOVERY_FRONTEND_URL=http://localhost:4200
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# --- Pasarela de pago (CU13/CU14/CU24) ---
# mock = simulación académica local. stripe = Checkout alojado real.
# El MODO de Stripe no se escribe aquí ni en el código: se deriva de ENVIRONMENT.
#   ENVIRONMENT=development|test  -> Stripe TEST  (sk_test_..., cs_test_..., livemode=false)
#   ENVIRONMENT=production        -> Stripe LIVE  (sk_live_..., cs_live_..., livemode=true)
# Mezclar entornos (development + sk_live_..., production + sk_test_...) aborta
# el arranque antes de cualquier llamada de red.
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
# Secreto de firma del webhook. En local lo genera `stripe listen` (whsec_...) y es
# independiente del secreto del endpoint LIVE configurado en Stripe.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
PAYMENTS_FRONTEND_URL=http://localhost:4200

# Subida firmada de imágenes del catálogo; credenciales solo en el backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CU09: validación de la dirección de sucursal con OpenStreetMap/Nominatim.
# No usa claves. Desactivado por defecto; el backend es el único que consulta
# al proveedor y guarda latitud/longitud (numeric(9,6) NULL) al validar.
GEOCODING_PROVIDER=disabled
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT=5
GEOCODING_USER_AGENT=LiveClothesShop/1.0 (proyecto academico)

# =============================================================================
# ESCENARIO B — PRODUCCIÓN (documentación; NO escribir estos valores en .env)
# Se configuran como Environment Variables en el proveedor del backend.
# Usar los dominios reales del despliegue en lugar de los placeholders.
# =============================================================================
# ENVIRONMENT=production
# PASSWORD_STORAGE=argon2id
# DATABASE_URL=postgresql+psycopg://USUARIO_LIVE:PASSWORD_URL_ENCODED@HOST_LIVE:5432/DATABASE_LIVE
# CLIENTE_ROL_ID=ROL_PLACEHOLDER
# SESSION_HOURS=8
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# ALLOWED_ORIGINS=["https://TU-FRONTEND-PRODUCCION"]
# RECOVERY_DELIVERY=gmail
# RECOVERY_FRONTEND_URL=https://TU-FRONTEND-PRODUCCION
# PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_TU_CLAVE_LIVE
# STRIPE_WEBHOOK_SECRET=whsec_TU_SECRETO_DEL_ENDPOINT_LIVE
# STRIPE_CURRENCY=usd
# PAYMENTS_FRONTEND_URL=https://TU-FRONTEND-PRODUCCION
# GEOCODING_PROVIDER=disabled
#
# Recuerde: en producción los orígenes deben ser HTTPS y COOKIE_SAMESITE=none
# exige COOKIE_SECURE=true. Nunca versionar estos valores ni compartir claves.
